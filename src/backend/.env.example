# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SENDER_EMAIL=your_sender_email@gmail.com
BREVO_SMTP_KEY=your_brevo_smtp_key
ADMIN_EMAIL=your_admin_email@gmail.com

# App URL (set this after Railway gives you a domain)
BASE_URL=https://your-app.up.railway.app

# Adafruit IO
ADAFRUIT_IO_USERNAME=your_adafruit_username
ADAFRUIT_IO_KEY=your_adafruit_key

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Database path (Railway volume mount point)
DB_PATH=/data/WaterQA.db

# Node environment
NODE_ENV=production
